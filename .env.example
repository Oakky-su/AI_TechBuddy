# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง  (คำสั่ง: cp .env.example .env)
# ไฟล์ .env อยู่ใน .gitignore และ .dockerignore แล้ว จะไม่ถูก commit หรือ copy เข้า image

# ---- ThaiLLM / OpenThaiGPT ----
THAILLM_API_KEY=ใส่-api-key-ที่นี่
THAILLM_BASE_URL=http://thaillm.or.th/api/v1
THAILLM_MODEL=openthaigpt-thaillm-8b-instruct-v7.2

# true = ปิดโหมดคิด (reasoning) -> ตอบเร็วขึ้น แต่คุณภาพอาจลดลง
DISABLE_THINKING=false

# กุญแจเซ็น session cookie — ต้องตั้งค่าคงที่ ไม่งั้นประวัติแชทหายทุกครั้งที่รีสตาร์ต
SECRET_KEY=เปลี่ยนเป็นค่าสุ่มยาว ๆ

# true = เปิด Werkzeug debugger ตอนรันด้วย `python app.py` — ใช้เฉพาะตอนพัฒนาเท่านั้น
FLASK_DEBUG=false
